package templates

// SettingsPage lets the user manage watched folders and service credentials.
templ SettingsPage(v SettingsView) {
	@Layout("Ajustes") {
		@settingsContent(v)
	}
}

templ settingsContent(v SettingsView) {
	<div class="page-head">
		<div>
			<h1>Ajustes</h1>
			<p class="sub">Carpetas vigiladas y credenciales de los servicios</p>
		</div>
	</div>
	if v.Notice != "" {
		<div class="notice mb-6">
			@IconSm("check")
			<span>{ v.Notice }</span>
		</div>
	}
	<div class="settings-grid">

		<div class="card elev-sm block span-2">
			<h2>
				@Icon("folder")
				Carpetas vigiladas
			</h2>
			<p class="desc">Holocron escanea disco, nombres y medios sobre estas carpetas.</p>
			if len(v.Folders) == 0 {
				<p class="muted">Todavía no hay carpetas.</p>
			} else {
				<div>
					for _, f := range v.Folders {
						@folderRow(f)
					}
				</div>
			}
			<form class="add-row" method="post" action="/settings/folders" hx-post="/settings/folders" hx-target="body">
				<input class="input" type="text" name="label" required placeholder="Etiqueta (Películas)"/>
				<input class="input" type="text" name="path" required placeholder="/ruta/a/la/carpeta"/>
				<select class="input" name="purpose">
					for _, p := range v.Purposes {
						<option value={ p }>{ p }</option>
					}
				</select>
				<button class="btn btn-primary" type="submit">
					@IconSm("plus")
					Agregá carpeta
				</button>
			</form>
		</div>

		<div class="card elev-sm block">
			<h2>
				@Icon("plug")
				Jellyfin
			</h2>
			<p class="desc">Para inventariar la biblioteca y saber qué le falta subtítulos.</p>
			if v.Jellyfin.Configured {
				@credConnected(v.Jellyfin)
			} else {
				<form method="post" action="/settings/jellyfin" hx-post="/settings/jellyfin" hx-target="body">
					<div class="field">
						<label>Dirección del servidor</label>
						<input class="input" type="text" name="url" value={ v.JellyfinURL } placeholder="http://192.168.0.2:8096"/>
					</div>
					<div class="block-foot">
						<button type="submit" class="btn btn-secondary">Guardá</button>
					</div>
				</form>
				<hr class="sep"/>
				@JellyfinLink(v.JellyfinLink)
			}
		</div>

		<div class="card elev-sm block">
			<h2>
				@Icon("cap")
				OpenSubtitles
			</h2>
			<p class="desc">Para buscar y descargar subtítulos en español.</p>
			if v.OpenSubs.Configured {
				@credConnected(v.OpenSubs)
			} else {
			<form method="post" action="/settings/opensubtitles" hx-post="/settings/opensubtitles" hx-target="body">
				<div class="field">
					<label>Usuario</label>
					<input class="input" type="text" name="username" value={ v.OpenSubsUser } placeholder="usuario (para descargar)"/>
				</div>
				<div class="field">
					<label>
						API key
						if v.OpenSubsSet {
							<span class="saved">
								@IconSm("check")
								guardado
							</span>
						}
					</label>
					<input class="input" type="password" name="api_key" placeholder="API key de OpenSubtitles"/>
				</div>
				<div class="field">
					<label>Contraseña</label>
					<input class="input" type="password" name="password" placeholder="contraseña (dejá vacío para conservar)"/>
				</div>
				<div class="block-foot">
					<button type="submit" class="btn btn-primary">Guardá</button>
				</div>
			</form>
			}
		</div>

		<div class="card elev-sm block">
			<h2>
				@Icon("download")
				Actualizaciones
			</h2>
			<p class="desc">Holocron se compara con la última release publicada en GitHub.</p>
			@Updates(v.Updates)
		</div>

		<div class="card elev-sm block">
			<h2>
				@Icon("key")
				App iOS
			</h2>
			<p class="desc">Token para la API JSON que usa la app. La interfaz web no lo necesita.</p>
			<div id="api-token">
				if v.APITokenSet {
					<p class="muted">
						<span class="badge badge-yes">Token activo</span>
						Se guarda sólo su huella, así que no se puede volver a ver. Si lo perdiste, generá uno nuevo (el anterior deja de servir).
					</p>
					<div class="actions">
						<form hx-post="/settings/api-token" hx-target="#api-token" hx-swap="innerHTML">
							<button type="submit" class="btn btn-secondary">Generar uno nuevo</button>
						</form>
						<form method="post" action="/settings/api-token/revoke" hx-post="/settings/api-token/revoke" hx-target="body" hx-confirm="¿Revocar el token? La app va a dejar de conectarse.">
							<button type="submit" class="btn btn-danger">Revocar</button>
						</form>
					</div>
				} else {
					<p class="muted">Todavía no hay token: la API está cerrada.</p>
					<form hx-post="/settings/api-token" hx-target="#api-token" hx-swap="innerHTML">
						<button type="submit" class="btn btn-primary">
							@IconSm("plus")
							Generar token
						</button>
					</form>
				}
			</div>
		</div>

		<div class="card elev-sm block span-2">
			<h2>
				@Icon("down-cloud")
				qBittorrent
			</h2>
			<p class="desc">WebUI de qBittorrent-nox para administrar las descargas.</p>
			if v.Qbit.Configured {
				@credConnected(v.Qbit)
			} else {
			<form method="post" action="/settings/qbittorrent" hx-post="/settings/qbittorrent" hx-target="body">
				<div class="settings-grid">
					<div class="field">
						<label>URL de la WebUI</label>
						<input class="input" type="text" name="url" value={ v.QbitURL } placeholder="http://127.0.0.1:8080"/>
					</div>
					<div class="field">
						<label>Usuario</label>
						<input class="input" type="text" name="username" value={ v.QbitUser } placeholder="admin"/>
					</div>
					<div class="field">
						<label>
							Contraseña
							if v.QbitSet {
								<span class="saved">
									@IconSm("check")
									guardado
								</span>
							}
						</label>
						<input class="input" type="password" name="password" placeholder="contraseña de la WebUI"/>
					</div>
				</div>
				<div class="block-foot">
					<button type="submit" class="btn btn-primary">Guardá</button>
				</div>
			</form>
			}
		</div>

	</div>
}

// credConnected replaces a credential form once the credentials are stored.
//
// "Ya conectado" is what it says, and then it goes and checks. Stored is not
// the same as working — a moved server or a rotated password leaves the card
// looking configured and the feature broken — so the live answer arrives
// straight after the page and can contradict the badge.
templ credConnected(c SettingsCred) {
	<div class="cred-on">
		<p class="cred-state">
			<span class="badge badge-yes">
				@IconSm("check")
				Ya conectado
			</span>
			if c.StatusHref != "" {
				<span hx-get={ c.StatusHref } hx-trigger="load" hx-swap="outerHTML" class="muted">comprobando…</span>
			}
		</p>
		if len(c.Facts) > 0 {
			<ul class="stat-list">
				for _, f := range c.Facts {
					<li>
						<span class="stat-key">{ f.Label }</span>
						<span class="stat-val mono">{ f.Value }</span>
					</li>
				}
			</ul>
		}
		<div class="block-foot">
			<form method="post" action={ templ.SafeURL(c.ClearHref) } hx-post={ c.ClearHref } hx-target="body" hx-confirm={ c.Confirm }>
				<button type="submit" class="btn btn-danger">
					@IconSm("trash")
					Borrar credenciales y reconectar
				</button>
			</form>
		</div>
	</div>
}

// CredStatus is the live check, swapped in after the card renders.
templ CredStatus(ok bool, detail string) {
	if ok {
		<span class="badge badge-yes">{ detail }</span>
	} else {
		<span class="badge badge-no">{ detail }</span>
	}
}

templ folderRow(f SettingsFolderRow) {
	<div class="folder-row">
		<span class="badge badge-neutral">{ f.Label }</span>
		<span class="mono">{ f.Path }</span>
		<form method="post" action="/settings/folders/delete" hx-post="/settings/folders/delete" hx-confirm="¿Quitar esta carpeta?" hx-target="body">
			<input type="hidden" name="id" value={ intToStr(f.ID) }/>
			<button type="submit" class="btn btn-icon btn-danger" aria-label="Quitar">
				@IconSm("trash")
			</button>
		</form>
	</div>
}

// APITokenIssued shows a freshly generated token. It is the only time the
// plaintext is available, so the copy is emphasised.
templ APITokenIssued(token string) {
	<div class="notice mb-6">
		@IconSm("alert")
		<span>Copialo ahora: no se vuelve a mostrar.</span>
	</div>
	<p class="mono token-box">{ token }</p>
	<p class="muted">Cargalo en la app junto con la URL del server.</p>
	<div class="actions">
		<form method="post" action="/settings/api-token/revoke" hx-post="/settings/api-token/revoke" hx-target="body" hx-confirm="¿Revocar el token? La app va a dejar de conectarse.">
			<button type="submit" class="btn btn-danger">Revocar</button>
		</form>
	</div>
}

