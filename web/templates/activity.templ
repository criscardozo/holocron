package templates

import "strings"

// ActivityPage is what is happening right now: who is watching what, what
// arrived, what was asked for and what is downloading. Live over /events/activity, like the hardware screen.
templ ActivityPage(v ActivityView) {
	@Layout("Actividad") {
		<div class="page-head">
			<div>
				<h1>Actividad</h1>
				<p class="sub">Quién está mirando qué, y qué se está bajando</p>
			</div>
		</div>
		<div hx-ext="sse" sse-connect="/events/activity">
			<div sse-swap="activity" hx-swap="innerHTML">
				@ActivityLive(v)
			</div>
		</div>
	}
}

templ ActivityLive(v ActivityView) {
	if len(v.Errors) > 0 {
		<div class="notice error mb-6">
			@IconSm("alert")
			<span>
				{ notResponding(len(v.Errors)) } <strong>{ strings.Join(v.Errors, ", ") }</strong>. Lo que { showWhat(len(v.Errors)) } puede estar desactualizado o faltar.
			</span>
		</div>
	}
	if !v.HasJellyfin {
		<section class="card act-hero act-hero-empty">
			<h2>Reproduciendo</h2>
			<p class="muted">Jellyfin no está vinculado. Se configura en <a href="/settings">Ajustes</a>.</p>
		</section>
	} else if len(v.Playing) == 0 {
		<section class="card act-hero act-hero-empty">
			<h2>Reproduciendo</h2>
			<p class="act-hero-none">Nadie está mirando nada.</p>
			if v.Idle > 0 {
				<p class="muted">{ Plural(v.Idle, "cliente conectado sin reproducir", "clientes conectados sin reproducir") }</p>
			}
		</section>
	} else {
		for _, p := range v.Playing {
			@actHero(p)
		}
	}

	if len(v.Recent) > 0 {
		<section class="act-section">
			<header class="section-head">
				<h2>Agregado hace poco</h2>
				@moreLink("/media", "Ver la biblioteca")
			</header>
			@posterRow(v.Recent)
		</section>
	}

	<div class="act-grid">
		if v.HasSeerr {
			<section class="card act-card">
				<header class="hw-head">
					<h2>Pedidos</h2>
					<span class="muted">{ v.ReqSummary }</span>
				</header>
				if len(v.Requests) == 0 {
					<p class="muted">Nadie pidió nada todavía.</p>
				} else {
					<ul class="req-list">
						for _, r := range v.Requests {
							<li>
								@poster(r.Art, r.Title)
								<span class="req-text">
									<span class="req-title">{ r.Title }</span>
									<span class="muted">{ r.Kind } · { r.By } · { r.When }</span>
								</span>
								<span class={ "badge", templ.KV("badge-yes", r.Done), templ.KV("badge-no", r.Stuck), templ.KV("badge-neutral", !r.Done && !r.Stuck) }>{ r.State }</span>
							</li>
						}
					</ul>
				}
			</section>
		}

		<div class="act-col">
			<section class="card act-card">
				<header class="hw-head">
					<h2>Descargas</h2>
					if v.HasTorrents {
						<span class="mono num muted">↓ { v.Down } · ↑ { v.Up }</span>
					}
				</header>
				if !v.HasTorrents && !v.HasArr {
					<p class="muted">No hay qBittorrent ni Radarr/Sonarr configurados.</p>
				} else if len(v.Downloads) == 0 {
					<p class="muted">No se está bajando nada.</p>
				} else {
					<ul class="act-list">
						for _, d := range v.Downloads {
							@actDownload(d)
						}
					</ul>
				}
			</section>

			if len(v.Upcoming) > 0 {
				<section class="card act-card">
					<header class="hw-head"><h2>Próximamente</h2><span class="muted">30 días</span></header>
					<ul class="act-recent">
						for _, u := range v.Upcoming {
							<li>
								<span>
									{ u.Subject }
									<span class="muted">· { u.Kind }</span>
								</span>
								<span class="muted num">{ u.When }</span>
							</li>
						}
					</ul>
				</section>
			}

			if len(v.Attention) > 0 {
				<section class="card act-card">
					<header class="hw-head">
						<h2>Para mirar</h2>
						<span class="muted">{ v.LibAge }</span>
					</header>
					<ul class="act-recent">
						for _, a := range v.Attention {
							<li class={ templ.KV("act-warn", a.Warn) }>
								if a.Href != "" {
									<a href={ templ.SafeURL(a.Href) }>{ a.Text }</a>
								} else {
									<span>{ a.Text }</span>
								}
							</li>
						}
					</ul>
				</section>
			}
		</div>
	</div>
}

// actHero is one session playing, large, over its own poster blurred. The
// first thing on the screen, because it is the thing happening.
templ actHero(p ActPlaying) {
	<section class="card act-hero">
		if p.Art != "" {
			<img class="act-hero-bg" src={ p.Art } alt="" aria-hidden="true"/>
		}
		<div class="act-hero-in">
			@poster(p.Art, p.Title)
			<div class="act-hero-text">
				<h2 class="act-hero-title">{ p.Title }</h2>
				if p.Subtitle != "" {
					<p class="act-hero-sub">{ p.Subtitle }</p>
				}
				<p class="muted">{ p.Who }</p>
				@hwBar(p.Width, false)
				<div class="act-meta">
					// The state reads beside the position it qualifies, not as a
					// label stacked over the title.
					if p.Paused {
						<span class="badge badge-neutral">
							@IconSm("pause")
							en pausa
						</span>
					} else {
						<span class="badge badge-play">
							@IconSm("play")
							reproduciendo
						</span>
					}
					<span class="mono num muted">{ p.Position }</span>
					<span class={ "badge", templ.KV("badge-yes", !p.Transcode), templ.KV("badge-neutral", p.Transcode) }>{ p.Method }</span>
					if p.Hardware != "" {
						<span class={ "badge", templ.KV("badge-yes", !p.OnCPU), templ.KV("badge-no", p.OnCPU) }>{ p.Hardware }</span>
					}
				</div>
				if p.Detail != "" || len(p.Reasons) > 0 {
					<div class="act-meta muted act-small">
						{ p.Detail }
						for _, r := range p.Reasons {
							<span>· { r }</span>
						}
					</div>
				}
			</div>
		</div>
	</section>
}

templ actDownload(d ActDownload) {
	<li class={ "act-item", templ.KV("act-problem", d.Problem) }>
		<div class="act-title">
			if d.App != "" {
				<span class="badge badge-neutral">{ d.App }</span>
			} else {
				<span class="badge badge-neutral">a mano</span>
			}
			<strong>{ d.Subject }</strong>
		</div>
		@hwBar(d.Width, d.Problem)
		<div class="act-meta">
			<span class="mono num">{ d.Pct }</span>
			if d.Speed != "" {
				<span class="mono num muted">{ d.Speed }</span>
			}
			if d.ETA != "" {
				<span class="muted">{ d.ETA }</span>
			}
			<span class="muted">{ d.State }</span>
		</div>
		for _, m := range d.Messages {
			<div class="act-small act-warn">{ m }</div>
		}
	</li>
}
