package templates

// Home is the start page, laid out like Ginebra's portal: the name over the
// poster wall, a row of readings, and a tile per area that doubles as the way
// in. What arrived lately closes it, as posters.
templ Home(v HomeView) {
	@Layout("Inicio") {
		<section class="home-hero">
			// Ginebra's own mark, as on the portal this page replaced: under
			// merli.store this is the server's front door, not only its panel.
			<h1 class="home-marca">
				<img src="/static/ginebra-marca.svg" alt="Ginebra, HTPC Server" width="476" height="128"/>
			</h1>
			<div class="home-status">
				for _, st := range v.Status {
					<span class={ "glass-chip", templ.KV("tone-ok", st.Tone == "ok"), templ.KV("tone-warn", st.Tone == "warn"), templ.KV("tone-danger", st.Tone == "danger") }>{ st.Text }</span>
				}
			</div>
			if len(v.Attn) > 0 {
				<div class="attn">
					for _, c := range v.Attn {
						@attnChip(c)
					}
				</div>
			}
		</section>
		<div class="tiles">
			for _, t := range v.Tiles {
				@tile(t)
			}
		</div>
		if len(v.Apps) > 0 {
			@homeApps(v.Apps)
		}
		if len(v.Recent) > 0 {
			<section class="home-recent">
				<header class="section-head">
					<h2>Agregado hace poco</h2>
					@moreLink("/media", "Ver la biblioteca")
				</header>
				@posterRow(v.Recent)
			</section>
		}
	}
}

templ tile(t Tile) {
	<a href={ templ.SafeURL(t.Href) } class={ "tile", "glass", templ.KV("tile-warn", t.Warn), templ.KV("tile-off", t.Off) }>
		<span class={ "tile-icon", "tone-" + t.Tone }>
			@Icon(t.Icon)
		</span>
		<span class="tile-title">{ t.Title }</span>
		<span class="tile-value">{ t.Value }</span>
		<span class="tile-sub">{ t.Sub }</span>
	</a>
}

// posterRow is a horizontal row of posters with a caption under each.
templ posterRow(items []ActRecent) {
	<ul class="poster-row">
		for _, r := range items {
			<li class="poster-card">
				@poster(r.Art, r.Title)
				<strong>{ r.Title }</strong>
				<span class="muted">
					if r.Subtitle != "" {
						{ r.Subtitle } ·
					}
					{ r.When }
				</span>
			</li>
		}
	</ul>
}

// poster is one poster image, or a placeholder with the title's initial when
// there is none. Lazy, because a row or a grid is mostly off screen.
templ poster(src, title string) {
	if src != "" {
		<img class="poster" src={ src } alt="" loading="lazy" decoding="async"/>
	} else {
		<span class="poster poster-empty" aria-hidden="true">{ initial(title) }</span>
	}
}

templ attnChip(c AttnChip) {
	<a class="chip" href={ templ.SafeURL(c.Href) }>
		@IconSm(c.Icon)
		{ c.Label }
	</a>
}

// homeApps are the doors to the rest of the stack: the two apps the house
// uses every day as large cards, the machinery behind them as chips. Plain
// links to other hosts, so htmx's boost leaves them alone.
templ homeApps(apps []AppLink) {
	<section class="home-apps">
		<header class="section-head">
			<h2>Apps</h2>
			@moreLink("/stack", "Ver el stack")
		</header>
		<div class="apps-main">
			for _, a := range apps {
				if a.Featured {
					<a class="app-card" href={ templ.SafeURL(a.URL) } hx-boost="false">
						<img src={ a.Logo } alt="" width="48" height="48"/>
						<span class="app-card-text">
							<strong>{ a.Name }</strong>
							<span class="muted">{ a.Short }</span>
						</span>
						<span class="app-go">
							@IconSm("chev")
						</span>
					</a>
				}
			}
		</div>
		<ul class="apps-chips">
			for _, a := range apps {
				if !a.Featured {
					<li>
						<a class="app-chip" href={ templ.SafeURL(a.URL) } title={ a.Short } hx-boost="false">
							<img src={ a.Logo } alt="" width="22" height="22"/>
							{ a.Name }
						</a>
					</li>
				}
			}
		</ul>
	</section>
}

// moreLink is a section's "see all" link, with a drawn chevron rather than a
// typed one a screen reader would read out.
templ moreLink(href, label string) {
	<a href={ templ.SafeURL(href) } class="more-link">
		{ label }
		@IconSm("chev")
	</a>
}

