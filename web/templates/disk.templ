package templates

import (
	"fmt"
	"strings"
)

// bar renders a proportion bar filled to pct percent. hot switches the fill to
// the accent gradient (near-full disks). The width comes from a .pw-N class
// (strict CSP: no inline styles).
templ bar(pct int, hot bool) {
	<div class={ "bar", templ.KV("hot", hot) }>
		<div class={ "bar-fill", pwClass(pct) }></div>
	</div>
}
// DiskPage is the disk detail page.
templ DiskPage(v DiskPageView) {
	@Layout("Disco") {
		@diskContent(v)
	}
}

templ diskContent(v DiskPageView) {
	<div class="page-head">
		<div>
			<h1>Disco</h1>
			<p class="sub">Cada disco, qué guarda y cómo está · escaneá uno para ver qué ocupa lugar</p>
		</div>
	</div>
	if v.Empty {
		<p class="muted">No hay discos configurados. En el servidor se configuran con <span class="mono">HOLOCRON_DISKS</span>.</p>
	} else {
		for _, a := range v.Alerts {
			@diskAlert(a)
		}
		<ul class="disk-cards">
			for _, c := range v.Cards {
				<li>
					@diskCard(c)
				</li>
			}
		</ul>
		if v.Selected != nil {
			@DiskDetailSection(*v.Selected)
		}
	}
}

templ diskAlert(a DiskAlert) {
	<div class={ "notice", "disk-alert", "mb-6", templ.KV("error", a.Bad) } role="status">
		@IconSm("alert")
		<div class="disk-alert-text">
			<strong>{ a.Text }</strong>
			if a.Detail != "" {
				<span>{ a.Detail }</span>
			}
		</div>
		if a.Action != "" {
			<form method="post" action={ templ.SafeURL(a.Action) }>
				if a.Field != "" {
					<input type="hidden" name={ a.Field } value={ a.Value }/>
				}
				<button type="submit" class="btn btn-secondary">{ a.Button }</button>
			</form>
		}
	</div>
}

// diskCard is one disk at a glance, and the way into its scan.
templ diskCard(c DiskCard) {
	<article class={ "card", "disk-card", templ.KV("disk-card-active", c.Active), templ.KV("disk-card-off", c.Checked && !c.Mounted) }>
		<header class="disk-card-head">
			<div class="disk-card-name">
				<h2>
					if c.Href != "" {
						<a href={ templ.SafeURL(c.Href) }>{ c.Name }</a>
					} else {
						{ c.Name }
					}
				</h2>
				if c.Model != "" {
					<span class="muted">{ c.Model }</span>
				}
			</div>
			if c.Role != "" {
				<span class="badge badge-neutral">{ c.Role }</span>
			}
		</header>
		if c.StatOK && (c.Mounted || !c.Checked) {
			<div class="disk-card-use">
				<span class="disk-card-pct">{ fmt.Sprintf("%d %%", c.UsedPercent) }</span>
				<span class="muted">{ c.FreeHuman } libres de { c.TotalHuman }</span>
			</div>
			@bar(c.UsedPercent, c.UsedPercent >= 90)
		}
		<div class="disk-card-state">
			if c.Checked {
				if c.Mounted {
					<span class="badge badge-yes">montado</span>
				} else {
					<span class="badge badge-no">no montado</span>
				}
			}
			if c.Asleep {
				<span class="badge badge-neutral">durmiendo</span>
				if c.AsleepAge != "" {
					<span class="muted">{ c.AsleepAge }</span>
				}
			}
			if c.Temp != "" {
				<span class={ "mono", templ.KV("muted", c.TempAge != "") }>
					{ c.Temp }
					if c.TempAge != "" {
						· { c.TempAge }
					}
				</span>
			}
		</div>
		if c.Health != "" {
			<p class={ "disk-card-health", "disk-health-" + c.HealthTone }>
				{ c.Health }
				if c.Realloc != "" {
					<span class={ templ.KV("disk-realloc-up", c.ReallocUp), templ.KV("muted", !c.ReallocUp) }>· { c.Realloc }</span>
				}
			</p>
		}
		if c.Libraries != "" {
			<p class="disk-card-holds"><span class="muted">Guarda</span> { c.Libraries }</p>
		}
	</article>
}

// DiskDetailSection is the per-folder detail; it is re-fetched via hx-select
// after a scan completes, so it carries a stable id.
templ DiskDetailSection(d DiskDetail) {
	<section id="disk-detail">
		<div class="disk-hero">
			<div class="disk-detail-title">
				<h2>{ d.Label }</h2>
				<span class="mono muted">{ d.Path }</span>
			</div>
			<div class="hero-actions">
				if d.HasResult && !d.Scanning {
					<div class="job done">
						@IconSm("refresh")
						Escaneado { d.ScannedAt }
					</div>
				}
				<form method="post" action="/disk/scan" hx-post="/disk/scan" hx-target="#scan-status" hx-swap="innerHTML">
					<input type="hidden" name="folder" value={ d.FolderID }/>
					<button type="submit" class="btn btn-primary" disabled?={ d.Scanning }>
						@IconSm("refresh")
						if d.Scanning {
							Escaneando…
						} else {
							Escanear (despierta el disco)
						}
					</button>
				</form>
			</div>
		</div>
		<div id="scan-status">
			if d.Scanning {
				@ScanStatus(ScanStatusView{Running: true, StatusHref: "/disk/status?folder=" + d.FolderID})
			}
		</div>
		if d.HasResult {
			<div class="card elev-sm sec mb-6">
				<h2 class="section-title">Carpetas más grandes</h2>
				if d.Stale {
					<p class="notice mb-6">
						Escaneo anterior al cambio de discos: puede contar como de este disco una carpeta
						que es de otro. Volvé a escanear.
					</p>
				}
				<ul class="largest">
					for _, t := range d.Top {
						@diskTopRow(t)
					}
				</ul>
				if d.Hidden != "" {
					// What statfs counts and no folder explains: on Ginebra's
					// Disco4, the old copy of Películas under the bind mount.
					<div class="disk-hidden">
						<div class="row-head">
							<span class="name">
								@IconSm("info")
								Ocupado y no visible
							</span>
							<span class="sz">{ d.Hidden }</span>
						</div>
						<p class="muted">
							Espacio que el disco cuenta como usado y que ninguna carpeta visible explica.
							Suele ser lo que quedó debajo de un montaje, como una copia vieja tapada por
							otro disco montado encima.
						</p>
					</div>
				}
				if len(d.NoAccess) > 0 {
					<p class="muted disk-noaccess">Sin acceso: { strings.Join(d.NoAccess, ", ") }</p>
				}
				@errorList(d.Errors)
			</div>
			<div class="card elev-sm sec">
				<h2 class="section-title">Explorador</h2>
				<div id="browse"><p class="muted">Clickeá una carpeta de arriba para explorarla.</p></div>
			</div>
		} else if !d.Scanning {
			<p class="muted">Todavía no se escaneó esta carpeta. Tocá «Escanear».</p>
		}
	</section>
}

templ diskTopRow(t DiskTopRow) {
	if t.Foreign {
		<li class="disk-top-foreign">
			<div class="row-head">
				<span class="name">
					@IconSm("drive")
					{ t.Name }
				</span>
				<span class="muted">
					es el
					if t.ForeignHref != "" {
						<a href={ templ.SafeURL(t.ForeignHref) }>{ t.ForeignName }</a>
					} else {
						{ t.ForeignName }
					}
				</span>
			</div>
		</li>
	} else {
		@diskTopRowSized(t)
	}
}

templ diskTopRowSized(t DiskTopRow) {
	<li>
		<button type="button" hx-get={ t.BrowseHref } hx-target="#browse" hx-swap="innerHTML" aria-label={ "Explorar " + t.Name }>
			<div class="row-head">
				<span class="name">
					@IconSm("folder")
					{ t.Name }
				</span>
				<span class="sz">{ t.BytesHuman }</span>
			</div>
			@bar(t.Percent, false)
		</button>
	</li>
}

templ errorList(errs []string) {
	if len(errs) > 0 {
		<details class="errors">
			<summary>{ fmt.Sprintf("%d avisos", len(errs)) }</summary>
			<ul>
				for _, e := range errs {
					<li>{ e }</li>
				}
			</ul>
		</details>
	}
}

// ScanStatus is the scan progress fragment. While running it polls itself; when
// done it triggers a reload of the detail section.
templ ScanStatus(v ScanStatusView) {
	if v.Running {
		<div class="job running" hx-get={ v.StatusHref } hx-trigger="every 2s" hx-swap="outerHTML">
			<span class="spinner"></span> Escaneando…
		</div>
	} else if v.Error != "" {
		<div class="job error">Error: { v.Error }</div>
	} else {
		<div class="job done" hx-get={ v.ReloadHref } hx-trigger="load delay:300ms" hx-select="#disk-detail" hx-target="#disk-detail" hx-swap="outerHTML">
			@IconSm("check")
			Listo. { v.Summary }
		</div>
	}
}

// BrowseFragment is one level of the drill-down.
templ BrowseFragment(v BrowseView) {
	<div class="browse">
		<div class="crumbs">
			if v.HasParent {
				<button type="button" class="btn btn-secondary btn-icon" aria-label="Subir un nivel" hx-get={ v.ParentHref } hx-target="#browse" hx-swap="innerHTML">
					@IconSm("up")
				</button>
			}
			<span class="mono">{ v.Path }</span>
			<span class="num muted ml-auto">{ v.TotalHuman }</span>
		</div>
		<div class="explorer">
			for _, e := range v.Entries {
				@browseRow(e)
			}
		</div>
	</div>
}

templ browseRow(e BrowseRow) {
	if e.Foreign {
		// Another disk mounted inside this one: not measured as this disk.
		<div class="fs-row fs-foreign">
			@IconSm("drive")
			<span class="nm">{ e.Name }</span>
			<span class="muted">
				es el
				if e.ForeignHref != "" {
					<a href={ templ.SafeURL(e.ForeignHref) }>{ e.ForeignName }</a>
				} else {
					{ e.ForeignName }
				}
			</span>
		</div>
	} else if e.IsDir {
		<button type="button" class="fs-row dir" hx-get={ e.BrowseHref } hx-target="#browse" hx-swap="innerHTML" aria-label={ "Abrir " + e.Name }>
			@IconSm("folder")
			<span class="nm">{ e.Name }</span>
			<div class="bar mini"><div class={ "bar-fill", pwClass(e.Percent) }></div></div>
			<span class="num">{ e.BytesHuman }</span>
		</button>
	} else {
		<div class="fs-row">
			@IconSm("file")
			<span class="nm">{ e.Name }</span>
			<div class="bar mini"><div class={ "bar-fill", pwClass(e.Percent) }></div></div>
			<span class="num">{ e.BytesHuman }</span>
		</div>
	}
}
