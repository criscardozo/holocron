package templates

// PlexLink is the device-link fragment. While a code is pending it polls
// itself every 2s; once linked it offers the discovered servers so the address
// does not have to be typed either.
templ PlexLink(v PlexLinkView) {
	<div id="plex-link">
		if v.Error != "" {
			<div class="notice error mb-6">
				@IconSm("alert")
				<span>{ v.Error }</span>
			</div>
		}
		if v.Pending {
			<div class="job" hx-get="/settings/plex/link/status" hx-trigger="every 2s" hx-target="#plex-link" hx-swap="outerHTML">
				<span class="spinner"></span>
				<span>Esperando que autorices en plex.tv…</span>
			</div>
			<p class="muted link-step">
				1. Abrí <a href={ templ.SafeURL(v.AuthURL) } target="_blank" rel="noopener noreferrer">plex.tv/link</a> e iniciá sesión.
			</p>
			<p class="muted link-step">2. Ingresá este código:</p>
			<p class="link-code">{ v.Code }</p>
			<form method="post" action="/settings/plex/link/cancel" hx-post="/settings/plex/link/cancel" hx-target="body">
				<button type="submit" class="btn btn-secondary">Cancelar</button>
			</form>
		} else if v.Linked {
			<div class="notice mb-6">
				@IconSm("check")
				<span>Cuenta vinculada. El token quedó guardado.</span>
			</div>
			if len(v.Servers) > 0 {
				<p class="muted link-step">Elegí el servidor a usar:</p>
				for _, srv := range v.Servers {
					@plexServerRow(srv)
				}
			} else {
				<p class="muted">No se detectaron servidores automáticamente. Cargá la URL a mano abajo.</p>
			}
		} else {
			<p class="desc">Vinculá tu cuenta y Holocron obtiene el token solo, sin que tengas que buscarlo en el navegador.</p>
			<form hx-post="/settings/plex/link" hx-target="#plex-link" hx-swap="outerHTML">
				<button type="submit" class="btn btn-primary">
					@IconSm("plug")
					Conectar con Plex
				</button>
			</form>
		}
	</div>
}

templ plexServerRow(srv PlexServerOption) {
	<form class="server-row" method="post" action="/settings/plex/link/server" hx-post="/settings/plex/link/server" hx-target="body">
		<input type="hidden" name="base_url" value={ srv.BaseURL }/>
		<div>
			<div>{ srv.Name }</div>
			<div class="mono muted">{ srv.BaseURL }</div>
		</div>
		<button type="submit" class="btn btn-primary">Usar</button>
	</form>
}
