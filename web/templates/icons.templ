package templates

// Icon and IconSm reference a symbol from the shared SVG sprite embedded in the
// layout (see Layout). They are decoration beside a text or inside a control
// that carries its own aria-label, so screen readers skip them.
templ Icon(id string) {
	<svg class="ic" aria-hidden="true" focusable="false"><use href={ "#" + id }></use></svg>
}

templ IconSm(id string) {
	<svg class="ic ic-sm" aria-hidden="true" focusable="false"><use href={ "#" + id }></use></svg>
}

// navLink renders one sidebar link, marking it aria-current when its label
// matches the current page title.
templ navLink(it navItem, current string) {
	if it.Label == current {
		<a href={ templ.SafeURL(it.Href) } class="side-link" aria-current="page">
			@IconSm(it.Icon)
			<span>{ it.Label }</span>
		</a>
	} else {
		<a href={ templ.SafeURL(it.Href) } class="side-link">
			@IconSm(it.Icon)
			<span>{ it.Label }</span>
		</a>
	}
}
