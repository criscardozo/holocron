package templates

import "fmt"

// JobStatus is a generic progress fragment reused by long-running features.
templ JobStatus(v JobStatusView) {
	if v.Running {
		<div class="job running" hx-get={ v.StatusHref } hx-trigger="every 2s" hx-swap="outerHTML">
			<span class="spinner"></span> { v.Label }
		</div>
	} else if v.Error != "" {
		<div class="job error">Error: { v.Error }</div>
	} else {
		<div class="job done" hx-get={ v.ReloadHref } hx-trigger="load delay:300ms" hx-select={ v.ReloadSelect } hx-target={ v.ReloadTarget } hx-swap="outerHTML">
			@IconSm("check")
			Listo. { v.Summary }
		</div>
	}
}
// MediaPage is the media detail page.
templ MediaPage(v MediaPageView) {
	@Layout("Medios") {
		<div class="page-head">
			<div>
				<h1>Medios</h1>
				<p class="sub">Inventario de Jellyfin: qué hay en disco y qué tiene subtítulos en español</p>
			</div>
		</div>
		if !v.Configured {
			<p class="muted">Vinculá tu servidor Jellyfin en <a href="/settings">Ajustes</a> para inventariar tus medios.</p>
		} else {
			@MediaDetailSection(v)
		}
	}
}

// MediaDetailSection is re-fetched when the sync job completes.
templ MediaDetailSection(v MediaPageView) {
	<section id="media-detail">
		<div class="card stat-band">
			<h2 class="sr-only">Resumen</h2>
			<div class="stat-trio">
				<div><div class="n">{ fmt.Sprintf("%d", v.Total) }</div><div class="cap">ítems</div></div>
				<div><div class="n">{ fmt.Sprintf("%d", v.Movies) }</div><div class="cap">películas</div></div>
				<div><div class="n warn">{ fmt.Sprintf("%d", v.WithoutSubs) }</div><div class="cap" title="Según Jellyfin, en toda la biblioteca (incluye lo que no gestionan Radarr ni Sonarr). Bazarr cuenta aparte, en Actividad, sólo lo suyo.">sin subtítulos ES, según Jellyfin</div></div>
			</div>
			<div class="actions">
				<form hx-post="/media/sync" hx-target="#media-status" hx-swap="innerHTML">
					<button class="btn btn-primary" type="submit" disabled?={ v.Syncing }>
						@IconSm("plug")
						Sincronizar desde Jellyfin
					</button>
				</form>
				<a class="btn btn-secondary" href="/quality">
					@IconSm("gauge")
					Ver calidad
				</a>
			</div>
		</div>
		<div id="media-status"></div>
		if len(v.Items) > 0 {
			// Posters, not a table: this is a film library, and a cover is
			// found at a glance where a title has to be read. The path stays
			// in the tooltip for when it is the path that matters.
			<h2 class="sr-only">Biblioteca</h2>
			<ul class="poster-grid">
				for _, it := range v.Items {
					<li class="poster-card" title={ it.Path }>
						@poster(it.Art, it.Title)
						<strong>{ it.Title }</strong>
						<span class="muted">
							{ typeLabelOf(it.Type) } · { yearStr(it.Year) }
							if !it.HasSubsES {
								<span class="badge badge-no">sin subs ES</span>
							}
						</span>
					</li>
				}
			</ul>
			if v.Truncated {
				<p class="muted">Se muestran { fmt.Sprintf("%d", len(v.Items)) } de { fmt.Sprintf("%d", v.Total) } ítems.</p>
			}
		} else {
			<p class="muted">Sin inventario. Tocá «Sincronizar desde Jellyfin».</p>
		}
	</section>
}
